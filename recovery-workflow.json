    {
      "parameters": {
        "jsCode": "// Compare la vidéo de la data table avec sa page Notion.\nconst video = $('Loop over videos').first().json;\nconst page = $input.first().json;\nconst exists = !!page.id;\nconst notionHasRaw = exists && page.property_transcript === true;\nconst notionHasProcessed = exists && page.property_transcript_process === true;\n\nlet status = 'missing';\nif (exists) status = notionHasRaw && notionHasProcessed ? 'complete' : 'incomplete';\n\nreturn [{\n  json: {\n    url: video.url,\n    title: video.title,\n    temp_has_raw: video.has_raw,\n    temp_has_processed: video.has_processed,\n    notion_page_id: page.id || null,\n    notion_has_raw: notionHasRaw,\n    notion_has_processed: notionHasProcessed,\n    status,\n  },\n}];"
      },
      "id": "9f9c61e9-15ae-4c41-b881-96d766eec52a",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
