      "parameters": {
        "jsCode": "// Nombre de lignes supprimées (ou qui le seraient, en dry run) pour cette vidéo.\n// En dry run, le node renvoie chaque ligne deux fois (dryRunState before / after) : on ne compte que l'état « before ».\nconst video = $('Cleanup temp rows ?').first().json;\nconst rows = $input.all().filter(item => item.json.id != null && item.json.dryRunState !== 'after');\nreturn [{ json: { ...video, temp_rows_deleted: rows.length } }];",
        "language": "javaScript",
