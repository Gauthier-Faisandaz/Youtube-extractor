        "jsCode": "const video = $('Classify').first().json;\nconst dryRun = $('Config').first().json.dry_run;\nlet action = 'skipped (already complete)';\nif (video.status !== 'complete' && dryRun) action = 'dry run';\nreturn [{ json: { ...video, action, error: null } }];"
      },
