      "id": "e3a191ac-357f-4c12-94fd-a2acdf271e27",
      "name": "Get all temp rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        448,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Une ligne par URL : la data table peut contenir plusieurs lignes pour la même vidéo.\nconst onlyUrl = ($('Config').first().json.only_url || '').trim();\nconst byUrl = new Map();\n\nfor (const { json: row } of $input.all()) {\n  if (!row.video_url) continue;\n  if (onlyUrl && row.video_url !== onlyUrl) continue;\n  const video = byUrl.get(row.video_url) || {\n    url: row.video_url,\n    title: '',\n    row_ids: [],\n    has_raw: false,\n    has_processed: false,\n  };\n  video.title = video.title || row.video_name || '';\n  video.row_ids.push(row.id);\n  video.has_raw = video.has_raw || !!row.video_transcript;\n  video.has_processed = video.has_processed || !!row.processed_transcript;\n  byUrl.set(row.video_url, video);\n}\n\nreturn [...byUrl.values()].map(json => ({ json }));"
      },
      "id": "305c3faa-aba7-4cef-bc94-292eaea73c2f",
      "name": "Dedupe videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const videos = $input.all().map(item => item.json);\nconst dryRun = $('Config').first().json.dry_run;\nconst countBy = key => videos.reduce((acc, video) => {\n  acc[video[key]] = (acc[video[key]] || 0) + 1;\n  return acc;\n}, {});\nconst cleaned = videos.filter(v => (v.temp_rows_deleted || 0) > 0);\nconst rowCount = cleaned.reduce((sum, v) => sum + v.temp_rows_deleted, 0);\n\nreturn [{\n  json: {\n    dry_run: dryRun,\n    total: videos.length,\n    by_status: countBy('status'),\n    by_action: countBy('action'),\n    temp_rows: {\n      [dryRun ? 'would_delete' : 'deleted']: rowCount,\n      videos: cleaned.length,\n    },\n    to_process: videos.filter(v => v.status !== 'complete').map(v => ({ url: v.url, title: v.title, status: v.status })),\n    failed: videos.filter(v => v.action === 'failed').map(v => ({ url: v.url, title: v.title, error: v.error })),\n  },\n}];"
      },
      "id": "979272ee-41c9-4814-a21e-a85e09f9dd37",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -128
      ]
    },
