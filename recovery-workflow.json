      "id": "5a5804cb-7c7a-4540-b4db-ba8711648225",
      "name": "Process video with Youtube_extractor",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1792,
        -32
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Résultat d'une vidéo envoyée à Youtube_extractor, revérifié dans Notion.\nconst video = $('Classify').first().json;\nconst result = $('Process video with Youtube_extractor').first().json;\nconst page = $input.first().json;\nconst error = result.error ? (result.error.message || String(result.error)) : null;\nconst nowComplete = !!page.id\n  && page.property_transcript === true\n  && page.property_transcript_process === true;\n\nreturn [{ json: { ...video, action: error ? 'failed' : 'processed', error, now_complete: nowComplete } }];"
      },
